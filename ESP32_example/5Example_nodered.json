    {
        "id": "8f233e417ca2bcbd",
        "type": "function",
        "z": "6d8fb87f7851dc10",
        "name": "parse ",
        "func": "// Tisztítjuk a sorvégi \\r\\n karaktereket\nlet raw = String(msg.payload).trim();\n\n// Csak a kapcsos zárójellel kezdődő JSON sorokkal foglalkozunk\nif (!raw.startsWith(\"{\")) {\n    return null; // Nem JSON sor (pl. boot üzenet) eldobása\n}\n\ntry {\n    // Szövegből valódi JSON (JS) objektum készítése\n    let data = JSON.parse(raw);\n    msg.payload = data;\n    return msg;\n} catch (e) {\n    node.warn(\"Hibás JSON érkezett: \" + raw);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 270,
        "y": 600,
        "wires": [
            [
                "bd964d9a3489bbd9",
                "f83809bbc6025638",
                "0e6378b6e267ab99",
                "3e1b83f7e8177865"
            ]
        ]
    },
